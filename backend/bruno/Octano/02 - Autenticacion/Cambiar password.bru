meta {
  name: Cambiar password
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/auth/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "actual": "Password12345!",
    "nueva": "NuevaPassword12345!"
  }
}

vars:post-response {
  token: res.body.tokenAcceso
  tallerId: res.body.usuario.tallerId
  usuarioId: res.body.usuario.id
}
