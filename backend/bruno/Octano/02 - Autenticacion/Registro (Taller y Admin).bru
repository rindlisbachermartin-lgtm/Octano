meta {
  name: Registro (Taller y Admin)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/registro
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@octano.local",
    "password": "Password12345!",
    "taller": {
      "nombre": "Taller San Cayetano",
      "calle": "Av. Mitre",
      "altura": 450,
      "telefono": "02392 456789"
    }
  }
}

vars:post-response {
  token: res.body.tokenAcceso
  tallerId: res.body.usuario.tallerId
  usuarioId: res.body.usuario.id
}
