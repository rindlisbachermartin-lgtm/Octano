meta {
  name: Crear presupuesto
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/presupuestos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "clienteId": {{clienteId}},
    "vehiculoId": {{vehiculoId}},
    "descripcion": "Servicio de mantenimiento",
    "manoObra": 10000,
    "porcentajeIva": 21,
    "tiposTrabajo": [
      "SERVICE"
    ],
    "items": [
      {
        "repuestoId": {{repuestoId}},
        "cantidad": 2
      },
      {
        "descripcion": "Insumos adicionales",
        "cantidad": 1,
        "precioUnitario": 500
      }
    ]
  }
}

vars:post-response {
  presupuestoId: res.body.id
}
