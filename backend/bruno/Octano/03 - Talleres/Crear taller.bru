meta {
  name: Crear taller
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/talleres
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@octano.local",
    "password": "Password12345!",
    "taller": {
      "nombre": "Taller Belgrano",
      "calle": "Calle Belgrano",
      "altura": 250,
      "telefono": "02392 554433"
    }
  }
}

vars:post-response {
  token: res.body.tokenAcceso
  tallerId: res.body.usuario.tallerId
  usuarioId: res.body.usuario.id
}
