meta {
  name: Crear taller
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/talleres
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@octano.local",
    "password": "Password12345!",
    "taller": {
      "nombre": "Baller Belgrano",
      "calle": "Calle Belgrano",
      "altura": 250,
      "telefono": "02392 554433",
      "cuit": "20-12345678-6",
      "ingresosBrutos": "000456",
      "inicioActividades": "2021-06-15",
      "condicionIvaId": 1
    }
  }
}

vars:post-response {
  token: res.body.tokenAcceso
  tallerId: res.body.usuario.tallerId
  usuarioId: res.body.usuario.id
}
