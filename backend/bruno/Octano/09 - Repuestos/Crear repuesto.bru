meta {
  name: Crear repuesto
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/repuestos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "codigoOem": "FILTRO-001",
    "descripcion": "Filtro de aceite",
    "marca": "Marca de prueba",
    "precioCosto": 1000,
    "margen": 30,
    "stockMinimo": 2
  }
}

vars:post-response {
  repuestoId: res.body.id
}
