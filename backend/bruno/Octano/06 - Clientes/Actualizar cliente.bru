meta {
  name: Actualizar cliente
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/clientes/{{clienteId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nombre": "Juan Perez",
    "documento": "12.345.678",
    "telefono": "02392 555555",
    "email": "juan@ejemplo.test",
    "calle": "Calle 123",
    "altura": 100,
    "condicionIvaId": 1
  }
}
