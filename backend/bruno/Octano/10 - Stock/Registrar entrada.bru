meta {
  name: Registrar entrada
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/repuestos/{{repuestoId}}/movimientos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "tipo": "ENTRADA",
    "cantidad": 10,
    "motivo": "Compra de repuestos"
  }
}

vars:post-response {
  movimientoId: res.body.id
}
