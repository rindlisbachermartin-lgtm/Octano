# Copiar a .env.properties y completar la contraseña local de PostgreSQL.
# No subir .env.properties a Git.
DB_URL=jdbc:postgresql://localhost:5432/octano
DB_USERNAME=postgres
DB_PASSWORD=
TEST_DB_URL=jdbc:postgresql://localhost:5432/octano_test
# Clave aleatoria Base64 de al menos 32 bytes. No usar contraseñas ni el valor de pruebas.
JWT_SECRET=
