# Keep vendored upstream bytes and patch provenance reproducible on Windows.
frontend/vendor/** text eol=lf
# Preserve upstream EOFs and the required blank context lines of unified diffs.
frontend/vendor/braces/lib/stringify.js whitespace=-blank-at-eof
frontend/vendor/node-forge/LICENSE whitespace=-blank-at-eof
frontend/vendor/patches/*.patch whitespace=-blank-at-eol
