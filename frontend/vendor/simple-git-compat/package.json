{
  "name": "@octano/simple-git-compat",
  "version": "4.0.2-octano.1",
  "private": true,
  "description": "Default-export compatibility for Nuxt DevTools with patched simple-git 4",
  "type": "module",
  "main": "index.cjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "files": ["index.cjs", "index.mjs", "index.d.ts"],
  "dependencies": {
    "simple-git-modern": "npm:simple-git@4.0.2"
  }
}
